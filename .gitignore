# 密钥与本地环境变量（示例文件照常入库）
.env
.env.*
!.env.example

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.swp

# 浏览器自动化（playwright MCP）的截图与日志
.playwright-mcp/

# Claude Code 本机设置（里面的自动记忆目录是本机绝对路径）
.claude/settings.local.json

# 逆向目标的工作目录：拆出来的原始代码、抓包、本机数据副本，一律不进仓库
targets/*/_work/
*.har
*.pcap
*.pcapng
*.mitm

# 项目局部的分析引擎（Ghidra 等），体积大且可重新下载
.tools/

# 各子项目自己装的依赖，靠锁文件还原
node_modules/

# 仿刻客户端本机编译出来的原生小程序
targets/*/clone/*/build/
__pycache__/
targets/*/clone/*/dist/
