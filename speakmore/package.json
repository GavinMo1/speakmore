{
  "name": "speakmore",
  "productName": "SpeakMore",
  "version": "0.1.0",
  "private": true,
  "description": "macOS 上的语音输入：按一下热键说话，整理好的文字贴进当前输入框。用你自己的 Gemini key",
  "license": "MIT",
  "keywords": [
    "dictation",
    "voice-input",
    "speech-to-text",
    "macos",
    "gemini"
  ],
  "homepage": "https://github.com/zephyr4123/reverse-anything/tree/main/speakmore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zephyr4123/reverse-anything.git",
    "directory": "speakmore"
  },
  "type": "module",
  "main": "src/app/main.mjs",
  "bin": {
    "speakmore": "bin/speakmore.mjs"
  },
  "files": [
    "bin",
    "src",
    "native",
    "build/key-helper",
    "build/key-helper.source-sha256",
    "scripts/build-native.mjs"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node bin/speakmore.mjs",
    "build:native": "node scripts/build-native.mjs",
    "prepack": "node scripts/build-native.mjs --universal",
    "dist": "node scripts/package.mjs",
    "install-app": "sh scripts/install-app.sh",
    "test": "node --test --test-timeout=5000 \"test/**/*.test.mjs\"",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "biome check .",
    "check": "biome check . && npm test"
  },
  "dependencies": {
    "@google/genai": "2.29.0",
    "electron": "44.7.0",
    "opencc-js": "1.4.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "20.3.0"
  }
}
