{
  "name": "speakmore",
  "productName": "SpeakMore",
  "version": "0.2.0",
  "private": true,
  "description": "macOS 上的语音输入：按一下热键说话，整理好的文字贴进当前输入框。用你自己的 Gemini key",
  "license": "MIT",
  "keywords": [
    "dictation",
    "voice-input",
    "speech-to-text",
    "macos",
    "gemini"
  ],
  "homepage": "https://github.com/zephyr4123/speakmore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zephyr4123/speakmore.git"
  },
  "type": "module",
  "main": "src/app/main.mjs",
  "bin": {
    "speakmore": "bin/speakmore.mjs"
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "start": "node bin/speakmore.mjs",
    "build:native": "node scripts/build-native.mjs",
    "release": "node scripts/release.mjs",
    "publish-release": "node scripts/publish-release.mjs",
    "dist": "node scripts/package.mjs",
    "install-app": "sh scripts/install-app.sh",
    "test": "npm run test:unit && npm run test:install",
    "test:unit": "node --test --test-timeout=5000 \"test/*.test.mjs\" \"test/app/*.test.mjs\" \"test/cli/*.test.mjs\" \"test/server/*.test.mjs\" \"test/scripts/*.test.mjs\" \"test/themes/*.test.mjs\"",
    "test:install": "node --test --test-timeout=120000 \"test/install/*.test.mjs\"",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "biome check .",
    "check": "biome check . && npm test"
  },
  "dependencies": {
    "@google/genai": "2.29.0",
    "electron": "44.7.0",
    "opencc-js": "1.4.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/get": "5.1.0",
    "@electron/packager": "20.3.0",
    "cos-nodejs-sdk-v5": "3.0.0"
  }
}
